# Production deployment settings. Copy this file to `.env` and replace every placeholder.
DB_NAME=mujiza_db
DB_SUPERUSER=postgres
DB_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ADMIN_PASSWORD
DB_USERNAME=mujiza_app
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_ADMIN_PASSWORD
ADMIN_FULL_NAME=Mo'jiza 777 Admin

# Public DNS A/AAAA records must point to this server; ports 80 and 443 must be reachable.
PUBLIC_DOMAIN=your-real-domain.example
PUBLIC_BASE_URL=https://your-real-domain.example
NEXT_PUBLIC_SITE_URL=https://your-real-domain.example
CORS_ALLOWED_ORIGINS=https://your-real-domain.example,https://www.your-real-domain.example

# Keep local for a single-server start. Use S3/R2 for multi-server deployments.
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=mujiza-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Optional Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# Initial single-node tuning; benchmark before increasing these values.
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=10000
TOMCAT_MAX_THREADS=100
TOMCAT_ACCEPT_COUNT=500
TOMCAT_MAX_CONNECTIONS=1500
